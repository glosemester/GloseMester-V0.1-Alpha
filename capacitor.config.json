{
  "appId": "no.glosemester.app",
  "appName": "GloseMester",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchFadeOutDuration": 500,
      "backgroundColor": "#FAFAF8",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#FAFAF8"
    }
  }
}
