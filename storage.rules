rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Diktat-lydopptak: kun autentisert eier kan lese/skrive sine egne filer
    match /diktat/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024; // Maks 10 MB per fil
    }
  }
}
