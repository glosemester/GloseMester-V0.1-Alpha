# Firebase-config for v3. Kopier til app-v3/.env og fyll inn for å overstyre
# standardverdiene i src/lib/firebase.ts (f.eks. for et test-/staging-prosjekt).
# Web-API-nøkkelen er ikke en hemmelighet (sikkerhet ligger i Firestore-regler).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
