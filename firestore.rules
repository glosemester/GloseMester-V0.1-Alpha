rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ OPPDATERT: Admin-sjekk via Firestore config (ikke hardkodet)
    // Admin-status er nå lagret i users-dokumentet
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rolle == 'admin';
    }

    function brukerData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    // Rollesjekk: kun lærere/admin kan opprette og eie prøver. Elever logger
    // aldri inn (jf. klient-rute-vakt i ProtectedRoute).
    function erLaererEllerAdmin(uid) {
      let r = brukerData(uid).get('rolle', 'elev');
      return r == 'laerer' || r == 'admin';
    }

    // ============================================
    // GLOSEMESTER
    // ============================================
    // ============================================
    // FELLES_PROVER - GloseBank (kun admin deler)
    // ============================================
    match /felles_prover/{testId} {
      // Les: Alle innloggede kan se GODKJENTE prøver
      allow read: if request.auth != null &&
                     (resource.data.status == 'approved' || isAdmin());

      // Skriv: KUN ADMIN (du godkjenner og deler)
      allow write: if isAdmin();
    }

    // GloseBank - admin har full tilgang
    match /glosebank/{glosebankId} {
      allow read: if request.auth != null &&
                     (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.abonnement.type == 'skolepakke'
                      || isAdmin());

      allow write: if isAdmin();
    }

    // GloseBank Ratings
    match /glosebank_ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.bruker_id == request.auth.uid;
    }

    // Standardprøver - premium/skolepakke + admin
    match /standardprover/{proveId} {
      allow read: if request.auth != null &&
                     (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.abonnement.type == 'premium'
                      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.abonnement.type == 'skolepakke'
                      || isAdmin());

      allow write: if isAdmin();
    }

    // Users - alle innloggede kan lese hoveddokumentet (trengs for klasse-roster).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      (request.auth.uid == userId || isAdmin());
    }

    // Prøver - støtter multi-fag (gloser, matte, norsk)
    // Les: Alle kan lese (elever er ikke innlogget, skanner QR-kode/bruker kode)
    // Skriv: Kun innloggede lærere (rollesjekk mot users-dokumentet), ubegrenset antall
    match /prover/{proveId} {
      allow read: if true;
      allow create: if request.auth != null
                       && request.resource.data.opprettet_av == request.auth.uid
                       && erLaererEllerAdmin(request.auth.uid);
      allow update, delete: if request.auth != null &&
                              (resource.data.opprettet_av == request.auth.uid || isAdmin());
    }

    // Resultater — elevsvar på prøver.
    // Les: kun prøveeier (lærer) og admin — elever logger aldri inn og har
    // ingen konto å lese resultater tilbake til.
    // Opprett: åpen — gjester leverer uten innlogging (kode-flyt og offline-kø).
    match /resultater/{resultatId} {
      allow read: if request.auth != null &&
                     (resource.data.prove_eier == request.auth.uid || isAdmin());
      allow create: if true;
      allow update, delete: if request.auth != null &&
                              (resource.data.prove_eier == request.auth.uid || isAdmin());
    }

    // School inquiries (Skolepakke-forespørsler)
    match /school_inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
