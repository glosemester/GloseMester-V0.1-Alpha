rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ OPPDATERT: Admin-sjekk via Firestore config (ikke hardkodet)
    // Admin-status er nå lagret i users-dokumentet
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rolle == 'admin';
    }

    // ============================================
    // GLOSEMESTER
    // ============================================
    // ============================================
    // FELLES_PROVER - GloseBank (kun admin deler)
    // ============================================
    match /felles_prover/{testId} {
      // Les: Alle innloggede kan se GODKJENTE prøver
      allow read: if request.auth != null &&
                     (resource.data.status == 'approved' || isAdmin());

      // Skriv: KUN ADMIN (du godkjenner og deler)
      allow write: if isAdmin();
    }
    
    // GloseBank - admin har full tilgang
    match /glosebank/{glosebankId} {
      allow read: if request.auth != null && 
                     (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.abonnement.type == 'skolepakke'
                      || isAdmin());
      
      allow write: if isAdmin();
    }
    
    // GloseBank Ratings
    match /glosebank_ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.bruker_id == request.auth.uid;
    }
    
    // Standardprøver - premium/skolepakke + admin
    match /standardprover/{proveId} {
      allow read: if request.auth != null && 
                     (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.abonnement.type == 'premium'
                      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.abonnement.type == 'skolepakke'
                      || isAdmin());
      
      allow write: if isAdmin();
    }
    
    // Users - admin kan lese/skrive alle
    match /users/{userId} {
      allow read: if request.auth != null && 
                     (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && 
                      (request.auth.uid == userId || isAdmin());
    }
    
    // Prøver - støtter multi-fag (gloser, matte, norsk)
    // Les: Alle kan lese (elever er ikke innlogget, skanner QR-kode)
    // Skriv: Kun innloggede lærere
    match /prover/{proveId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (resource.data.opprettet_av == request.auth.uid || isAdmin());
    }

    // Trades — anonym kortbytte mellom elever
    match /trades/{tradeId} {
      allow read: if true;
      allow create: if
        request.resource.data.status == 'pending' &&
        request.resource.data.code is string &&
        request.resource.data.initiatorDevice is string;
      allow update: if
        resource.data.status in ['pending', 'accepted'];
      allow delete: if false;
    }

    // Resultater
    // Alle resultater har nå 'prove_type' felt
    match /resultater/{resultatId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null &&
                              (resource.data.prove_eier == request.auth.uid || isAdmin());
    }
    
    // School inquiries (Skolepakke-forespørsler)
    match /school_inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Orders (Stripe-betalinger)
    match /orders/{orderId} {
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}